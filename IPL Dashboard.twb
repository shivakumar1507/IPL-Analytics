      <column caption='Strike Rate' datatype='real' name='[Calculation_0933762513965057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([runs_batter]) * 100 / COUNT([ball])' />
      </column>
      <column caption='Boundary %' datatype='real' name='[Calculation_0933762514259970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(&#13;&#10;IF [runs_batter] = 4 OR [runs_batter] = 6&#13;&#10;THEN 1 END&#13;&#10;)&#13;&#10;/ COUNT([ball])) * 100' />
      </column>
      <column caption='Match Phase' datatype='string' name='[Calculation_0933762514472963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [over] &lt;= 5 THEN &quot;Powerplay&quot;&#13;&#10;ELSEIF [over] &lt;= 14 THEN &quot;Middle Overs&quot;&#13;&#10;ELSE &quot;Death Overs&quot;&#13;&#10;END' />
      </column>
      <column caption='Dot Ball' datatype='integer' name='[Calculation_0933762515066884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [runs_total] = 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Boundary Runs' datatype='integer' name='[Calculation_0933762515197957]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [runs_batter] = 4 OR [runs_batter] = 6&#13;&#10;THEN [runs_batter]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Boundary Count' datatype='integer' name='[Calculation_0933762515320838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [runs_batter] = 4 OR [runs_batter] = 6&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Wicket Flag' datatype='integer' name='[Calculation_0933762515484679]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([player_out]) THEN 0 ELSE 1 END' />
      </column>
      <column caption='Sixes' datatype='integer' name='[Calculation_0933762518450184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [runs_batter] = 6 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Avg Match Score' datatype='real' name='[Calculation_0933762546925577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([runs_total]) / COUNTD([match_id])' />
      </column>
