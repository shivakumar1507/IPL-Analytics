          </datasources>
          <datasource-dependencies datasource='federated.1eltiu113nf7jf1b5q4vj1bb4u8l'>
            <column caption='Strike Rate' datatype='real' name='[Calculation_0933762513965057]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([runs_batter]) * 100 / COUNT([ball])' />
            </column>
            <column caption='Wicket Flag' datatype='integer' name='[Calculation_0933762515484679]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([player_out]) THEN 0 ELSE 1 END' />
            </column>
            <column caption='Sixes' datatype='integer' name='[Calculation_0933762518450184]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [runs_batter] = 6 THEN 1 ELSE 0 END' />
            </column>
            <column caption='Avg Match Score' datatype='real' name='[Calculation_0933762546925577]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([runs_total]) / COUNTD([match_id])' />
            </column>
            <column caption='Ball' datatype='integer' name='[ball]' role='measure' type='quantitative' />
            <column-instance column='[match_id]' derivation='CountD' name='[ctd:match_id:qk]' pivot='key' type='quantitative' />
